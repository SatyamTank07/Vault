# Copy to .env in the host clone (C:\Satyam\Vault_Project\Vault_Host\.env). Never commit the real file.
POSTGRES_USER=vault_user
POSTGRES_PASSWORD=replace-with-a-long-random-password
POSTGRES_DB=vault_db

# Localhost port for opening the hosted Vault on this laptop.
VAULT_PORT=47800

# Folder for uploaded images. Default: C:\Satyam\Vault_Project\Vault_Host_data\uploads (next to the host clone).
# VAULT_UPLOADS_DIR=../Vault_Host_data/uploads

FRONTEND_URL=https://vault.satyamtank.com,http://localhost:47800

# From Cloudflare Zero Trust -> Networks -> Tunnels. Uncomment COMPOSE_PROFILES once it is set.
TUNNEL_TOKEN=
# COMPOSE_PROFILES=tunnel
